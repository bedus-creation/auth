APP_NAME="Auth Service"
APP_ENV="development"
APP_DEBUG="true"

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=auth_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Shared secret used to sign/verify JWTs (HS256). Generate a long random value.
JWT_SECRET="change-me"
JWT_ALGORITHM=HS256
JWT_TTL=3600

LOG_CHANNEL=stack
