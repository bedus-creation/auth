APP_NAME="Auth Service"
APP_ENV="development"
APP_DEBUG="true"

# SQLite (default, no DB server needed). Switch to postgres below for production.
DB_CONNECTION=sqlite
DB_URL=sqlite+aiosqlite:///storage/auth.sqlite
DB_DATABASE=storage/auth.sqlite

# DB_CONNECTION=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=auth_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Shared HS256 secret — every tenant service verifying tokens must hold this.
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-32+-byte-random-secret"
JWT_ALGORITHM=HS256
JWT_TTL=3600

# Admin secret for POST /tenants/{slug}/members (header x-admin-secret)
ADMIN_SECRET="change-me"

LOG_CHANNEL=stack
