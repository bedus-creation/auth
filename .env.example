APP_NAME="Auth Service"
APP_ENV="development"
APP_DEBUG="true"

DB_CONNECTION=sqlite
DB_URL=sqlite+aiosqlite:///storage/auth.sqlite
DB_DATABASE=storage/auth.sqlite

# Shared secret used to sign/verify JWTs (HS256). Use >= 32 bytes.
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-32+-byte-random-secret-value"
JWT_ALGORITHM=HS256
JWT_TTL=3600

# Central session cookie signing key (>= 32 bytes). openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32+-byte-random-session-key"

# OAuth2 authorization-code TTL (seconds) and admin secret for membership mgmt.
AUTH_CODE_TTL=60
ADMIN_SECRET="change-me"

# OAuth client registry. Comma-separate multiple redirect URIs.
TENANT_A_CLIENT_SECRET="change-me"
TENANT_A_REDIRECT_URIS="http://localhost/auth/callback"
TENANT_B_CLIENT_SECRET="change-me"
TENANT_B_REDIRECT_URIS="http://localhost/auth/callback"

LOG_CHANNEL=stack
