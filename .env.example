APP_NAME="Auth Service"
APP_ENV="development"
APP_DEBUG="true"

# SQLite (default, no DB server needed).
DB_CONNECTION=sqlite
DB_URL=sqlite+aiosqlite:///storage/auth.sqlite
DB_DATABASE=storage/auth.sqlite

# Shared HS256 secret — every tenant service verifying tokens must hold this.
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-32+-byte-random-secret"
JWT_ALGORITHM=HS256
JWT_TTL=3600

# Central session cookie signing key (>= 32 bytes). openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32+-byte-random-session-key"

LOG_CHANNEL=stack
