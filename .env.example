APP_NAME="Auth Service"
APP_ENV="development"
APP_DEBUG="true"

DB_CONNECTION=sqlite
DB_URL=sqlite+aiosqlite:///storage/auth.sqlite
DB_DATABASE=storage/auth.sqlite

# Shared secret used to sign/verify JWTs (HS256). Use >= 32 bytes.
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-32+-byte-random-secret-value"
JWT_ALGORITHM=HS256
JWT_TTL=3600

LOG_CHANNEL=stack
